# Telegram BotFather가 발급한 값입니다. 따옴표 없이 입력하세요.
TELEGRAM_BOT_TOKEN=여기에_봇_토큰
TELEGRAM_CHAT_ID=여기에_채팅_ID
SUBSCRIPTIONS_ENABLED=true

# 감시 대상
CGV_COMPANY_CODE=A420
CGV_SITE_NO=0013
CGV_SITE_NAME=용산아이파크몰
CGV_MOVIE_NO=30001323
MOVIE_LABEL=오디세이
CGV_RTCTL_SCOPE_CODE=08

# 오늘을 포함한 28일(4주)을 매일 자동으로 감시합니다.
DYNAMIC_DATE_WINDOW=true
TARGET_WINDOW_DAYS=28
APP_TIMEZONE=Asia/Seoul

# 고정 기간이 필요할 때만 DYNAMIC_DATE_WINDOW=false로 바꾸고 사용하세요.
# TARGET_START_DATE=2026-08-26
# TARGET_END_DATE=2026-09-08

# 상영 시작 시각이 지난 회차는 예매할 수 없으므로 알림에서 제외합니다.
# CGV가 상영 시작보다 일찍 예매를 닫는다면 그 시간(분)을 넣으세요.
BOOKING_CLOSE_MARGIN_MINUTES=0

# 좌석표에서 A열 여부를 못 읽어 보류된 회차를 몇 주기마다 다시 확인할지 정합니다.
# 이미 알림을 보낸 회차에만 적용되며, 좌석 수가 바뀌면 즉시 다시 확인합니다.
# 1로 두면 매 주기 확인합니다(이전 동작).
DEFERRED_RECHECK_CYCLES=5

# 상영 일정 응답에는 전체 잔여 수만 있어서, A열 1석이 팔리고 A열이 아닌 1석이
# 취소되면 전체 수가 그대로라 좌석 변화가 보이지 않습니다. 아래 두 값은 전체
# 수가 그대로여도 좌석표를 다시 읽을 날짜를 정합니다.
#   ALWAYS  - 오늘부터 이 일수까지는 매 주기 다시 읽습니다(0이면 사용 안 함).
#   ROTATE  - 그 뒤 이 일수까지는 하루씩 돌아가며 읽습니다(0이면 사용 안 함).
#   CYCLES  - ROTATE 구간을 몇 주기에 걸쳐 한 바퀴 돌지 정합니다.
# 기본값은 주기당 3일치(오늘·내일 + 순환 1일)를 더 읽습니다. 늘리면 취소표를
# 더 촘촘히 잡지만 주기가 길어지고 CGV 차단 위험이 커집니다.
SEAT_RECHECK_ALWAYS_DAYS=2
SEAT_RECHECK_ROTATE_DAYS=7
SEAT_RECHECK_ROTATE_CYCLES=5

# 잔여 좌석 알림은 예매 가능한 좌석이 있으면 매 주기 발송합니다(0 = 매 주기).
# 좌석 수가 바뀐 경우에는 이 값과 관계없이 항상 발송하고, 값이 바뀌지 않은
# 회차의 반복 알림만 이 간격만큼 미룹니다. 발송량이 많으면 30~60으로 올리세요.
SEAT_ALERT_REPEAT_MINUTES=0

# 모든 Telegram 알림은 Railway 볼륨의 영속 대기열을 거쳐 별도 작업자가
# 전송합니다. 일시적으로 실패하면 그 사람에게만 자동 재시도하며, 이 횟수만큼
# 실패하면 포기합니다. 봇을 차단했거나 계정이 사라진 경우에는 재시도하지 않고
# 구독 목록에서 바로 제거합니다.
PENDING_DELIVERY_MAX_ATTEMPTS=30

# 조회 범위 결정 방식입니다.
#   cursor - 신규 오픈 후보 날짜를 먼저 보고 요청 수를 줄입니다. (기본·권장)
#   full   - 매 주기 감시 기간 전체를 조회합니다.
# 로그의 "조회 시작: ..." 줄에서 실제 조회 범위를 확인할 수 있습니다.
SCAN_MODE=cursor
# cursor 모드에서 프론티어 뒤로 몇 일을 더 확인할지 정합니다.
CURSOR_PROBE_DAYS=3
# 새 오픈이 감지되면 회차가 없는 날짜가 나올 때까지 이어서 조회합니다.
# 이 값은 그 조회가 한 주기에 넘지 않을 최대 일수(안전장치)입니다.
CURSOR_EXPANSION_DAYS=21
# cursor 모드에서도 이 주기마다 한 번은 전체를 조회합니다(누락 방지).
FULL_SCAN_EVERY_CYCLES=10

# 전체 조회는 2분 간격으로 시작합니다. 한 주기가 2분을 넘으면 종료 후 재개합니다.
# 아래 단일 재확인 모드를 사용하지 않을 때 HTTP 403도 이 간격으로 재시도합니다.
POLL_INTERVAL_SECONDS=120
# 운영자가 차단 복구를 시험할 때만 고유한 요청 이름을 넣습니다(예: recovery-20260920-1).
# 기본 동작은 배포 시작부터 1시간 CGV 조회 중단 → HTTP 요청 1건 확인입니다.
# 성공하면 정상 조회 복귀, 실패하면 수동 확인 전까지 CGV 자동 조회를 중단합니다.
# 상태는 볼륨에 저장되어 재시작·값 삭제로 중단이 풀리거나 재확인이 반복되지 않습니다.
# 재확인을 새로 승인할 때만 이전과 다른 이름으로 변경하세요.
CGV_RECOVERY_REQUEST_ID=
# 새 요청의 대기 시간(초). 기본 1시간이며, 운영자가 즉시 1건 확인을 승인한 경우만 0.
# 같은 요청 이름에서는 값을 바꿔도 저장된 예정 시각이나 중단 상태가 변경되지 않습니다.
CGV_RECOVERY_PAUSE_SECONDS=3600
# 별도 운영자 승인 헤더 진단: 일정 1건에 Sec-Fetch 헤더 3개만 추가합니다.
# 성공해도 자동 조회를 재개하지 않습니다. 같은 ID는 재시작해도 재실행하지 않습니다.
# 사용할 때만 고유 ID와 명시적 날짜(YYYY-MM-DD)를 함께 설정하세요.
CGV_HEADER_PROBE_REQUEST_ID=
CGV_HEADER_PROBE_DATE=
# 좌석 API를 진단할 때만 회원번호·토큰을 제거한 searchIfSeatData URL을 설정합니다.
# 날짜는 위 진단 날짜와 같아야 합니다. 빈 값이면 기존 일정 헤더 진단입니다.
CGV_HEADER_PROBE_SEAT_URL=
# Telegram 명령은 CGV 조회와 별도로 2초마다 확인합니다.
TELEGRAM_COMMAND_POLL_SECONDS=2
# CGV 조회와 별개인 발송 작업자가 최대 16명씩 동시에 보내되, 무료 Bot API
# 제한보다 낮은 초당 25건으로 시작 속도를 제한합니다. 신규 오픈은 좌석 변경과
# 공지보다 우선 발송되며, 둘 다 30보다 높이지 않는 것을 권장합니다.
TELEGRAM_BROADCAST_WORKERS=16
TELEGRAM_BROADCAST_RATE_PER_SECOND=25
# CGV 요청은 한꺼번에 보내지 않고 최소 2초 간격으로 전송합니다.
CGV_REQUEST_SPACING_SECONDS=2
# HTTP 429가 나오면 30분 대기하고, 연속 발생 시 60분·120분으로 늘립니다.
RATE_LIMIT_BACKOFF_INITIAL_SECONDS=1800
RATE_LIMIT_BACKOFF_MAX_SECONDS=7200
REQUEST_TIMEOUT_SECONDS=15

# 응답의 상영관/포맷 이름 또는 특수관 코드로 IMAX 회차만 고릅니다.
IMAX_KEYWORDS=IMAX,아이맥스
IMAX_CODE_VALUES=08
STRICT_IMAX_MATCH=true

# CGV 조회 오류 Telegram 알림의 재전송 간격(기본 6시간)
ERROR_ALERT_COOLDOWN_SECONDS=21600

# Railway에서는 /data 볼륨이 자동 감지됩니다. 필요할 때만 직접 지정하세요.
# STATE_DIR=/data
# LOG_DIR=/data

# 보통 수정하지 않습니다.
CGV_API_URL=https://cgv.co.kr/api/v1/booking/searchSchByMov
CGV_SEAT_API_URL=https://cgv.co.kr/api/v1/booking/searchIfSeatData
CGV_BOOKING_URL=https://cgv.co.kr/cnm/movieBook/movie
